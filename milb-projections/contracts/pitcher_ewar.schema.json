{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pitcher_ewar.schema.json",
  "title": "Pitcher eWAR exports (MLB champion + MiLB AAA/AA/High-A)",
  "publication_classification": "PRIVATE_EXPORT_REQUIRED (values); PUBLIC_SCHEMA_ONLY (this contract)",
  "excluded": ["Low-A pitcher eWAR (INTERNAL_ONLY, publication withheld — never exported by this package)"],
  "artifacts": {
    "mlb_pitcher_ewar": {
      "authoritative_source": "pitcher_ewar/data/pitcher_ewar.parquet",
      "schema_version": "pitcher-ewar-1.1.0",
      "observation_unit": "player_id x season",
      "primary_key": ["player_id", "season"],
      "required_columns": [
        "player_id", "player_name", "season", "team", "role", "starter_share", "opener_share",
        "bulk_reliever_share", "short_reliever_share", "innings_pitched", "batters_faced",
        "fi_runs_observed", "fi_runs_stabilized", "hr_runs_above_average", "hr_opportunity_runs",
        "hr_conversion_runs", "all_contact_suppression_runs", "contact_runs_above_average",
        "contact_missing", "league_adjustment_runs", "pitcher_runs_above_average",
        "replacement_runs", "runs_above_replacement", "runs_per_win", "pitcher_ewar",
        "fi_runs_sd", "contact_runs_sd", "pitcher_ewar_sd", "pitcher_ewar_low", "pitcher_ewar_high",
        "reliability", "sample_tier", "park_adjustment_method", "park_adjustment_confidence",
        "framing_treatment", "model_version", "as_of_date", "data_freshness"
      ],
      "label_columns": ["pitcher_ewar", "runs_above_replacement", "fi_runs_observed", "contact_runs_above_average", "hr_opportunity_runs", "hr_conversion_runs"],
      "context_columns": ["role", "starter_share", "opener_share", "bulk_reliever_share", "short_reliever_share", "sample_tier", "reliability"]
    },
    "milb_pitcher_ewar_aaa": {
      "authoritative_source": "milb_pitcher_ewar/data/aaa_pitcher_ewar.parquet",
      "schema_version": "milb-pitcher-ewar-1.0.0 (park-restated subset: 1.1.0)",
      "observation_unit": "player_id x level x league x season",
      "primary_key": ["player_id", "level", "league", "season"],
      "required_columns": [
        "player_id", "player_name", "season", "level", "league", "league_id", "org", "team_id",
        "role", "starter_share", "innings_pitched", "batters_faced", "fi_runs_observed",
        "fi_runs_stabilized", "hr_runs_above_average", "hr_opportunity_runs", "hr_conversion_runs",
        "contact_runs_above_average", "league_adjustment_runs", "pitcher_runs_above_average",
        "replacement_runs", "runs_above_replacement", "runs_per_win", "pitcher_ewar",
        "fi_runs_sd", "contact_runs_sd", "pitcher_ewar_sd", "pitcher_ewar_low", "pitcher_ewar_high",
        "reliability", "sample_tier", "architecture", "coverage_level", "missing_components",
        "park_adjustment_method", "framing_treatment", "model_version", "as_of_date"
      ],
      "label_columns": ["pitcher_ewar", "runs_above_replacement", "fi_runs_observed", "contact_runs_above_average", "hr_opportunity_runs", "hr_conversion_runs"],
      "context_columns": ["role", "starter_share", "architecture", "coverage_level", "missing_components", "sample_tier", "reliability"]
    },
    "milb_pitcher_ewar_aa_higha": {
      "authoritative_source": "milb_pitcher_ewar/data/{aa,higha}_pitcher_ewar.parquet",
      "schema_version": "milb-pitcher-ewar-1.0.0",
      "observation_unit": "player_id x level x league x season",
      "primary_key": ["player_id", "level", "league", "season"],
      "required_columns": [
        "player_id", "player_name", "team_id", "league", "level", "sportId", "season",
        "innings_pitched", "batters_faced", "so", "bb", "hbp", "hr", "g", "gs", "r", "org",
        "league_id", "runs_per_win", "lg_ra9", "fi_runs_observed", "fi_runs_stabilized",
        "starter_share", "role", "replacement_runs", "league_adjustment_runs",
        "pitcher_runs_above_average", "runs_above_replacement", "pitcher_ewar", "fi_runs_sd",
        "pitcher_ewar_sd", "pitcher_ewar_low", "pitcher_ewar_high", "sample_tier", "reliability",
        "architecture", "coverage_level", "missing_components", "park_adjustment_method",
        "framing_treatment", "model_version", "as_of_date"
      ],
      "known_absent_columns": ["contact_runs_above_average", "hr_opportunity_runs", "hr_conversion_runs"],
      "note": "contact_runs_sd column name exists for schema uniformity but is not meaningful at this level (no contact component exists) -- always gate on architecture == SEM_CORE / coverage_level == fi_only before use.",
      "label_columns": ["pitcher_ewar", "runs_above_replacement", "fi_runs_observed"],
      "context_columns": ["role", "starter_share", "architecture", "coverage_level", "missing_components", "sample_tier", "reliability"]
    },
    "aaa_contact_management_plus": {
      "authoritative_source": "milb_pitcher_ewar/data/aaa_contact_runs.parquet",
      "observation_unit": "pitcher x season",
      "primary_key": ["pitcher", "season"],
      "required_columns": ["pitcher", "season", "contact_runs_above_average", "n_bip"],
      "label_columns": ["contact_runs_above_average"],
      "context_columns": ["n_bip"]
    }
  }
}
