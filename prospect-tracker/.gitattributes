*.sh text eol=lf
# Read line-by-line by deploy/nightly-build.sh and the deploy workflow; a
# CRLF checkout would corrupt every path match, so pin LF like the scripts.
deploy/publish_paths.txt text eol=lf
deploy/data_exclude.txt text eol=lf

# The provisional-grade freeze (2026-09-25) is pinned by sha256 in
# test_provisional_freeze_pin.py; never let git convert its bytes.
data/provisional_freeze/** -text
# The 2026 MiLB season freeze (SG_1) is pinned by sha256 in
# data/efv_surrogate_pins_2026.json and test_milb_season_freeze.py; the pins are
# taken on the committed bytes, so never let git convert them.
data/milb_season_frozen/** -text
data/efv_surrogate_*.json -text
data/milb_norms_2026_pure.json -text

# tools/pixel_brand.py --check compares its text outputs byte for byte; never
# let git convert their line endings (core.autocrlf=true on the owner's box).
assets/brand/** -text
branding/pixel/** -text
branding/marks/** -text
branding/animated/*.svg -text

# The Z1 driver re-test arm list is pinned by sha256 in its registration and checked by
# the retest mode's --sha; never let git convert its bytes.
docs/efv-*/z1_arm_list.json -text

# The Awards freeze record is write-once and pinned by sha256 in data/_labs/awards/freeze_log.json;
# awards_export.py refuses a record whose bytes differ, so never let git convert them.
data/_labs/awards/frozen_*.json -text

# The projections forward vintage (docs/PROJ_FORWARD_VINTAGE_GATE.md) is write-once and pinned by
# sha256 in its FREEZE_LOG.json and test_proj_forward_vintage.py; never let git convert its bytes.
data/proj_forward_vintage/** -text
