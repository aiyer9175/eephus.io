*.sh text eol=lf
# Read line-by-line by deploy/nightly-build.sh and the deploy workflow; a
# CRLF checkout would corrupt every path match, so pin LF like the scripts.
deploy/publish_paths.txt text eol=lf
deploy/data_exclude.txt text eol=lf

# The provisional-grade freeze (2026-09-25) is pinned by sha256 in
# test_provisional_freeze_pin.py; never let git convert its bytes.
data/provisional_freeze/** -text

# tools/pixel_brand.py --check compares its text outputs byte for byte; never
# let git convert their line endings (core.autocrlf=true on the owner's box).
assets/brand/** -text
branding/pixel/** -text

# The Z1 driver re-test arm list is pinned by sha256 in its registration and checked by
# the retest mode's --sha; never let git convert its bytes.
docs/efv-*/z1_arm_list.json -text
