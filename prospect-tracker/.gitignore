# --- Generated artifacts ------------------------------------------------
# Source of truth is manual_rankings.csv + the scrapers. Everything below
# can be rebuilt by running `py -3 run_monthly.py`.
.cache/
prospects.db
prospects.db.bak*
prospects.db-journal
prospects.db-wal
prospects.db-shm
data/timeseries.json
data/graduates.json
data/debuts.json
data/inactive.json
data/rosters_by_org.json
# Source-vs-source backtest output (regenerated each monthly run; powers the
# Methodology & Track Record tab). Generated artifact, like timeseries.json.
data/source_backtest.json
# Resolved headshot-context map (regenerated by headshots.py each run; drives
# the prospect-photo fallback chain). Generated artifact.
data/photo_ctx.json
# v31.12 — pitch_plot sidecar (raw per-pitch coordinates for the
# detail-page chart). 100+ MB at full pipeline rebuild; over GitHub's
# 100 MB single-file ceiling. Generated by storage.export_timeseries_json.
data/pitch_plots.json
# v32 — split per player (data/pitch_plots/{key}.json, ~450KB each);
# same generated-artifact policy as the monolith it replaces.
data/pitch_plots/
# FanGraphs CSV drop folder — user-supplied exports + processed archive
data/fangraphs_imports/

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Accounts / Supabase ------------------------------------------------
# assets/eephus-config.js is now a COMMITTED-BLANK stub (kills the per-page
# 404 console error the missing file used to log; blank values keep the
# account layer dormant). Real values are filled at deploy time — keep them
# out of source control. Service-role keys NEVER live in the repo.
.env
.env.local

# --- Misc ---------------------------------------------------------------
*.log
