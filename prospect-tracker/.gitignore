# --- Generated artifacts ------------------------------------------------
# Source of truth is manual_rankings.csv + the scrapers. Everything below
# can be rebuilt by running `py -3 run_monthly.py`.
.cache/
prospects.db
prospects.db.bak*
prospects.db-journal
prospects.db-wal
prospects.db-shm
data/timeseries.json
data/graduates.json
data/debuts.json
data/inactive.json
data/rosters_by_org.json
# Source-vs-source backtest output (regenerated each monthly run; powers the
# Methodology & Track Record tab). Generated artifact, like timeseries.json.
data/source_backtest.json
# Resolved headshot-context map (regenerated by headshots.py each run; drives
# the prospect-photo fallback chain). Generated artifact.
data/photo_ctx.json
# v31.12 — pitch_plot sidecar (raw per-pitch coordinates for the
# detail-page chart). 100+ MB at full pipeline rebuild; over GitHub's
# 100 MB single-file ceiling. Generated by storage.export_timeseries_json.
data/pitch_plots.json
# v32 — split per player (data/pitch_plots/{key}.json, ~450KB each);
# same generated-artifact policy as the monolith it replaces.
data/pitch_plots/
# v33 — player_detail per-player sidecar (spray/rolling-xwOBA coordinates,
# game logs, historical per-source tools). Generated by export_timeseries_json.
data/player_detail/
# FanGraphs CSV drop folder — user-supplied exports + processed archive
data/fangraphs_imports/
# Tracked exception to the global *.csv ignore: scraped FanGraphs ARTICLE
# boards (e.g. Marlins 2026 Top 53). FanGraphs is Cloudflare-blocked so the
# deploy box can't re-scrape, and these aren't otherwise reproducible — commit
# them so run_monthly._stage_fangraphs_articles re-ingests them every build.
!data/fangraphs_articles/
!data/fangraphs_articles/*.csv

# --- Python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/

# --- Editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Accounts / Supabase ------------------------------------------------
# assets/eephus-config.js is now a COMMITTED-BLANK stub (kills the per-page
# 404 console error the missing file used to log; blank values keep the
# account layer dormant). Real values are filled at deploy time — keep them
# out of source control. Service-role keys NEVER live in the repo.
.env
.env.local

# --- Committed brand artifacts ------------------------------------------
# The repo-root .gitignore ignores *.png globally, but these are generated
# ONCE by tools/generate_brand_assets.py and must ship in source control:
# every page references the apple-touch icon and the Open Graph share card,
# and the nightly build must serve byte-identical icons without regenerating.
# (favicon.ico / favicon.svg aren't *.png, so they need no exception.)
!assets/favicon-32.png
!assets/apple-touch-icon.png
!assets/share-default.png
!assets/icon-192.png
!assets/icon-512.png
!assets/icon-maskable-512.png
# Per-player Open Graph cards (Pass C) live under assets/share/.
!assets/share/
!assets/share/*.png
# Branding bundle: the documented export folder (marks, icons, social cards,
# manifest, brand guide). Its PNGs are copies of the committed assets above.
!branding/icons/*.png
!branding/social/*.png
!branding/animated/*.png
!branding/animated/*.gif
!branding/animated/frames/
!branding/animated/frames/*.png

# --- Misc ---------------------------------------------------------------
*.log

# xFV training intermediates (regenerable from the DB)
data/xfv_hitter_matrix.json
data/xfv_pitcher_matrix.json
data/xfv_scored.json
data/xfv_scored_pitcher.json
