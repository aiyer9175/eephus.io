 "parlay_context": {
  "rules": [
   {
    "id": "same_game_any",
    "severity": "warn",
    "when": "two or more legs from the same game",
    "why": "Same-game outcomes share the run environment, the starters and the weather. Multiplying the legs is not arithmetic, it is an assumption, and it is wrong."
   },
   {
    "id": "ml_runline_same_team",
    "severity": "block",
    "when": "moneyline and runline on the same team",
    "why": "The runline is a subset of the moneyline. These are one bet with two prices, not two bets, and the product is meaningless."
   },
   {
    "id": "ml_and_total",
    "severity": "warn",
    "when": "a moneyline and the total in the same game",
    "why": "Favourite plus under and dog plus over are both positively correlated. The naive product is too cheap."
   },
   {
    "id": "same_team_props",
    "severity": "warn",
    "when": "two player props from the same lineup",
    "why": "Teammates share innings and baserunners. Hits and total bases on the same night rise and fall together."
   },
   {
    "id": "sp_k_and_team_ml",
    "severity": "warn",
    "when": "a starter strikeout prop with that team's moneyline",
    "why": "A dominant start moves both. Correlated legs price differently than the product suggests."
   }
  ],
  "legs": [],
  "featured_parlay": null,
  "featured_reason": "A featured parlay needs a backtest that survives the correlation haircut. There is not one, so there is no featured parlay.",
  "math_note": "Independent legs multiply. Same-game legs do not, and the naive product is always too generous to the bettor's story and too cheap for the book to sell at that price."
 },
