# Raw datasets & generated artifacts live in external storage, never in git.
# (full Statcast 285M, generated leaderboards/trajectories 57M, graphics)
data/raw/
data/processed/

# Small committed sample data is the exception
!data/samples/

# Data file types anywhere (belt-and-suspenders)
*.parquet
*.csv
!data/samples/*.csv

# Model artifacts / large binaries -> external storage
*.joblib
*.lgb
*.pkl
*.h5
*.zip

# Generated graphics (regenerated by report_card_*.py etc.)
*.png

# Python / env
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Secrets / local config
.env
*.local
secrets.json
