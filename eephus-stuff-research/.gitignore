# Secrets -- never commit these
.env
.env.*
*.pem
*.key
credentials*
secrets*
config/paths.yaml

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Virtual environment
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Large / private / raw data: handled deliberately, not by blanket exclusion.
# Small fixtures and manifests under tests/fixtures/ and data/manifests/ ARE
# meant to be versioned -- do not add a blanket data/ ignore here without a
# decision recorded in registry/decisions/ (Part H).
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/external/*
!data/external/.gitkeep

# Coverage artifacts
.coverage
htmlcov/

# eephus.io's root .gitignore blanket-ignores *.csv (data hygiene for the
# production repo). That rule reaches in here too, since a nested .gitignore
# only adds to the parent's rules. These specific fixture CSVs are small,
# deliberately-committed test data for the Part BV deliberate-failure
# harness, not research data -- carve them back out the same way the root
# .gitignore already carves out prospect-tracker/manual_rankings.csv.
!tests/fixtures/**/*.csv
