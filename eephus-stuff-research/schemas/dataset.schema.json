{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eephus.internal/schemas/dataset.schema.json",
  "title": "Dataset registry entry",
  "type": "object",
  "required": [
    "dataset_id", "logical_name", "source", "acquisition_method",
    "acquisition_timestamp", "grain", "row_count", "column_count",
    "unique_key", "duplicate_count", "schema_version"
  ],
  "properties": {
    "dataset_id": { "type": "string", "pattern": "^DS-[0-9]{3,}$" },
    "logical_name": { "type": "string" },
    "source": { "type": "string" },
    "acquisition_method": { "type": "string" },
    "acquisition_timestamp": { "type": "string", "format": "date-time" },
    "raw_parent": {
      "type": "array",
      "items": { "type": "string", "pattern": "^DS-[0-9]{3,}$" }
    },
    "transformations": { "type": "array", "items": { "type": "string" } },
    "grain": { "type": "string" },
    "seasons": { "type": "array", "items": { "type": "integer" } },
    "row_count": { "type": "integer", "minimum": 0 },
    "column_count": { "type": "integer", "minimum": 0 },
    "unique_key": { "type": "array", "items": { "type": "string" } },
    "duplicate_count": { "type": "integer", "minimum": 0 },
    "missingness_summary": { "type": "object" },
    "checksum": { "type": "string" },
    "schema_version": { "type": "string" },
    "licensing_restrictions": { "type": "string" }
  },
  "additionalProperties": false
}
