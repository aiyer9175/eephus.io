{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eephus.internal/schemas/experiment.schema.json",
  "title": "Experiment registry entry (preregistration)",
  "type": "object",
  "required": [
    "experiment_id", "question", "hypothesis", "estimand", "unit_of_analysis",
    "population", "inclusion_rules", "exclusion_rules", "features", "target",
    "grouping", "primary_metric", "benchmark", "falsification_rule",
    "promotion_rule", "seed", "status"
  ],
  "properties": {
    "experiment_id": { "type": "string", "pattern": "^E-[0-9]{3,}$" },
    "question": { "type": "string" },
    "hypothesis": { "type": "string" },
    "estimand": { "type": "string" },
    "unit_of_analysis": { "type": "string" },
    "population": { "type": "string" },
    "inclusion_rules": { "type": "array", "items": { "type": "string" } },
    "exclusion_rules": { "type": "array", "items": { "type": "string" } },
    "features": { "type": "array", "items": { "type": "string" } },
    "target": { "type": "string" },
    "training_period": { "type": "string" },
    "validation_period": { "type": "string" },
    "grouping": {
      "type": "string",
      "enum": ["RANDOM_ROW", "GAME_GROUPED", "PITCHER_GROUPED", "TEMPORAL", "PITCHER_GROUPED_TEMPORAL"]
    },
    "primary_metric": {
      "type": "string",
      "enum": ["RMSE", "MAE", "LOG_LOSS", "BRIER", "AUC", "R2", "SPEARMAN_R", "PEARSON_R", "CALIBRATION_SLOPE"]
    },
    "secondary_metrics": {
      "type": "array",
      "items": { "type": "string", "enum": ["RMSE", "MAE", "LOG_LOSS", "BRIER", "AUC", "R2", "SPEARMAN_R", "PEARSON_R", "CALIBRATION_SLOPE"] }
    },
    "benchmark": {
      "type": "string",
      "enum": ["TRAINING_TARGET", "FEATURE", "VALIDATION_ONLY", "DESCRIPTIVE_COMPARATOR", "PROHIBITED_FROM_MODEL", "NOT_APPLICABLE"]
    },
    "falsification_rule": { "type": "string", "minLength": 1 },
    "promotion_rule": { "type": "string" },
    "seed": { "type": "integer" },
    "status": {
      "type": "string",
      "enum": [
        "PASS", "PASS_WITH_FINDINGS", "FAIL", "BLOCKED", "NOT_ATTEMPTED",
        "NOT_IDENTIFIED", "NOT_MEASURED", "NOT_APPLICABLE",
        "INSUFFICIENT_EVIDENCE", "NEEDS_REVIEW"
      ]
    },
    "post_hoc_amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "change", "reason"],
        "properties": {
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
