{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eephus.internal/schemas/decision.schema.json",
  "title": "Decision registry entry",
  "type": "object",
  "required": [
    "decision_id", "question", "decision", "status", "rationale",
    "alternatives_considered", "decided_by", "created_at"
  ],
  "properties": {
    "decision_id": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
    "question": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["DECIDED", "PROVISIONAL", "BLOCKED", "REJECTED", "SUPERSEDED"]
    },
    "rationale": { "type": "string", "minLength": 1 },
    "alternatives_considered": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "why_not_chosen"],
        "properties": {
          "option": { "type": "string" },
          "why_not_chosen": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "decided_by": { "type": "string" },
    "supersedes": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
    "superseded_by": { "type": "string", "pattern": "^D-[0-9]{3,}$" },
    "created_at": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
